# ─────────────────────────────────────────────
# AntiGravity Chat — Backend Environment Config
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/antigravity_chat

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# LoRa Serial Port Configuration
LORA_PORT=COM3
LORA_BAUD=115200
LORA_ENABLED=true

# Node Name (matches STM32 #define NODE_NAME)
LORA_NODE_NAME=SERVER
